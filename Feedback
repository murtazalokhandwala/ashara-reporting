<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Ashara 1448H Toronto — Daily Feedback</title>
<style>
:root {
  --navy:#0F2744; --blue:#1A4F96; --green:#1D9E75;
  --red:#C0392B; --white:#FFFFFF; --bg:#F2F2F7;
  --card:#FFFFFF; --border:#E5E5EA; --muted:#8E8E93; --text:#1C1C1E;
  --safe-t:env(safe-area-inset-top,0px); --safe-b:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{min-height:100%;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);color:var(--text)}

.hdr{background:var(--navy);color:white;padding:14px 16px;padding-top:calc(14px + var(--safe-t));text-align:center}
.hdr-title{font-size:16px;font-weight:600}
.hdr-sub{font-size:11px;opacity:.6;margin-top:2px}

.content{padding:14px 12px;max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:12px;padding-bottom:calc(32px + var(--safe-b))}

/* DAY BANNER */
.day-banner{background:var(--blue);border-radius:12px;padding:13px 16px;}
.day-top{display:flex;align-items:center;justify-content:space-between}
.day-label{font-size:12px;color:rgba(255,255,255,.65);margin-bottom:2px}
.day-value{font-size:18px;font-weight:700;color:white}
.day-date{font-size:12px;color:rgba(255,255,255,.6);margin-top:2px}
.day-note{margin-top:10px;background:rgba(255,255,255,.12);border-radius:8px;padding:8px 11px;font-size:12px;color:rgba(255,255,255,.9);line-height:1.5}

/* PROGRESS */
.progress-wrap{background:var(--card);border-radius:10px;border:1px solid var(--border);padding:10px 14px}
.progress-label{font-size:12px;color:var(--muted);margin-bottom:6px;display:flex;justify-content:space-between}
.progress-bar{height:6px;background:#E5E5EA;border-radius:3px;overflow:hidden}
.progress-fill{height:100%;background:var(--green);border-radius:3px;transition:width .3s ease;width:0%}
.progress-note{font-size:11px;color:var(--muted);margin-top:5px}

/* CARDS */
.card{background:var(--card);border-radius:14px;border:1px solid var(--border);padding:16px;display:flex;flex-direction:column;gap:10px}
.card.has-error{border-color:var(--red)!important;background:#FFF8F8}
.card-label{font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}
.q-text{font-size:15px;font-weight:500;color:var(--text);line-height:1.4}
.inline-err{font-size:12px;color:var(--red);font-weight:500;display:none}
.inline-err.show{display:block}

/* GENDER */
.gender-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.gender-btn{padding:13px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg);font-size:15px;font-weight:500;color:var(--muted);cursor:pointer;text-align:center;transition:all .13s;user-select:none}
.gender-btn.sel-m{background:#E8F0FB;color:var(--blue);border-color:var(--blue)}
.gender-btn.sel-f{background:#F4ECF7;color:#6C3483;border-color:#8E44AD}

/* RATINGS */
.rating-row{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}
.r-btn{padding:11px 8px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg);font-size:13px;font-weight:500;color:var(--muted);cursor:pointer;text-align:center;transition:all .13s;display:flex;flex-direction:column;align-items:center;gap:4px;user-select:none}
.r-btn .r-icon{font-size:20px}
.r-btn.sel-e{background:#DFFAF0;color:#085041;border-color:var(--green)}
.r-btn.sel-g{background:#E8F0FB;color:#0C447C;border-color:var(--blue)}
.r-btn.sel-n{background:#FEF9E7;color:#7D5A00;border-color:#D4A017}
.r-btn.sel-na{background:#F2F2F7;color:var(--muted);border-color:#C7C7CC}

/* TEXTAREA */
textarea{width:100%;padding:12px;border-radius:10px;border:1.5px solid var(--border);background:var(--bg);font-size:14px;color:var(--text);resize:none;font-family:inherit;min-height:90px;outline:none;transition:border-color .13s}
textarea:focus{border-color:var(--blue)}
textarea::placeholder{color:var(--muted)}

/* ERROR BANNER */
.err-banner{background:#FFF0F0;border:1px solid #FFBEBE;border-radius:10px;padding:12px 14px;font-size:13px;color:var(--red);display:none;align-items:center;gap:8px;line-height:1.5}
.err-banner.show{display:flex}

/* SUBMIT */
.submit-btn{width:100%;padding:15px;border-radius:14px;border:none;background:var(--navy);color:white;font-size:16px;font-weight:700;cursor:pointer;transition:all .13s;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px}
.submit-btn:active{transform:scale(.98)}
.submit-btn:disabled{background:var(--muted);cursor:not-allowed}
.spinner{width:18px;height:18px;border:2px solid rgba(255,255,255,.3);border-top-color:white;border-radius:50%;animation:spin .7s linear infinite;display:none}
.spinner.show{display:block}
@keyframes spin{to{transform:rotate(360deg)}}

/* SUCCESS */
.success-screen{display:none;max-width:560px;margin:0 auto;padding:24px 16px;padding-bottom:calc(24px + var(--safe-b))}
.success-card{background:var(--card);border-radius:16px;border:1px solid var(--border);padding:36px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px}
.s-icon{font-size:52px}
.s-title{font-size:21px;font-weight:600;color:var(--navy)}
.s-sub{font-size:14px;color:var(--muted);line-height:1.7;max-width:280px}
.s-day{background:var(--blue);color:white;border-radius:8px;padding:6px 14px;font-size:13px;font-weight:500}
.s-note{font-size:12px;color:var(--muted)}
</style>
</head>
<body>

<div class="hdr">
  <div class="hdr-title">Daily Mumineen Feedback</div>
  <div class="hdr-sub">Ashara Mubaraka 1448H Toronto · Anjuman-e-Saifee</div>
</div>

<!-- FORM -->
<div class="content" id="formDiv">

  <!-- AUTO DAY BANNER -->
  <div class="day-banner">
    <div class="day-top">
      <div>
        <div class="day-label">Today's Ashara Day</div>
        <div class="day-value" id="dayVal">—</div>
        <div class="day-date" id="dayDate">—</div>
      </div>
      <div style="font-size:30px">📅</div>
    </div>
    <div class="day-note">
      📋 Please ensure your feedback is for <strong id="dayNoteVal">today</strong> only.<br>
      This form resets automatically each day.
    </div>
  </div>

  <!-- PROGRESS -->
  <div class="progress-wrap">
    <div class="progress-label">
      <span>Questions answered</span>
      <span id="progressCount">0 of 10</span>
    </div>
    <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
    <div class="progress-note" id="progressNote">Please answer at least 3 questions to submit.</div>
  </div>

  <!-- ERROR BANNER -->
  <div class="err-banner" id="errBanner">⚠️ <span id="errText">Please fix the errors below before submitting.</span></div>

  <!-- GENDER -->
  <div class="card" id="cardGender">
    <div class="card-label">About You <span style="color:var(--red)">*</span></div>
    <div class="q-text">Are you responding as:</div>
    <div class="gender-row">
      <div class="gender-btn" data-q="gender" data-v="Gents" onclick="pickGender(this,'sel-m')">🚹 Gents</div>
      <div class="gender-btn" data-q="gender" data-v="Ladies" onclick="pickGender(this,'sel-f')">🚺 Ladies</div>
    </div>
    <div class="inline-err" id="errGender">Please select Gents or Ladies to continue.</div>
  </div>

  <!-- QUESTIONS Q2–Q11 -->
  <div id="questionsDiv"></div>

  <!-- COMMENTS -->
  <div class="card">
    <div class="card-label">💬 Open Feedback <span style="color:var(--muted);font-weight:400;font-size:11px;text-transform:none">(optional)</span></div>
    <div class="q-text">Any suggestions or feedback for tomorrow?</div>
    <textarea id="comments" placeholder="Share any thoughts or areas for improvement…"></textarea>
  </div>

  <button class="submit-btn" id="submitBtn" onclick="submitForm()">
    <span id="btnText">Submit Feedback</span>
    <div class="spinner" id="spinner"></div>
  </button>
  <div style="text-align:center;font-size:12px;color:var(--muted)">Shukran for your time. Your feedback helps us improve each day. 🌹</div>

</div>

<!-- SUCCESS -->
<div class="success-screen" id="successDiv">
  <div class="success-card">
    <div class="s-icon">🌹</div>
    <div class="s-title">Shukran for your feedback!</div>
    <div class="s-day" id="successDay">—</div>
    <div class="s-sub">Your response has been recorded and will help us improve the Ashara experience for all Mumineen.</div>
    <div class="s-note">Anjuman-e-Burhani — Ashara 1448H Toronto</div>
  </div>
</div>

<script>
const APPSCRIPT_URL = 'https://script.google.com/macros/s/AKfycbyxAlUcn3SHXcxmDAC5-u3u19-FKxvvrb4CzauHHF5cU_g1x3bZ12ynYmScrKjddPuE/exec';
const MIN_ANSWERS = 3; // minimum rated questions before submit allowed

const DAYS = {
  '2026-06-14':{ m:'Pehli Raat',   d:'Sunday, June 14' },
  '2026-06-15':{ m:'1st Moharram', d:'Monday, June 15' },
  '2026-06-16':{ m:'2nd Moharram', d:'Tuesday, June 16' },
  '2026-06-17':{ m:'3rd Moharram', d:'Wednesday, June 17' },
  '2026-06-18':{ m:'4th Moharram', d:'Thursday, June 18' },
  '2026-06-19':{ m:'5th Moharram', d:'Friday, June 19' },
  '2026-06-20':{ m:'6th Moharram', d:'Saturday, June 20' },
  '2026-06-21':{ m:'7th Moharram', d:'Sunday, June 21' },
  '2026-06-22':{ m:'8th Moharram', d:'Monday, June 22' },
  '2026-06-23':{ m:'9th Moharram', d:'Tuesday, June 23' },
  '2026-06-24':{ m:'Yaume Ashura', d:'Wednesday, June 24' },
};

const QUESTIONS = [
  { id:'q2',  cat:'⭐ Overall',             text:'How would you rate your overall experience today?' },
  { id:'q3',  cat:'🅿️ Parking & Drop-Off',  text:'How would you rate the overall Parking and Drop-Off Nizaam today?' },
  { id:'q4',  cat:'🚶 Entry, Flow & Seating',text:'How would you rate the Entry Flow, Gate Nizaam and Seating today?' },
  { id:'q5',  cat:'📺 AV / Relay',           text:'How would you rate the audio, video and overall AV experience today?' },
  { id:'q6',  cat:'🍽️ Mawaid Nizaam',        text:'How would you rate the overall Mawaid Nizaam (seating & organisation) today?' },
  { id:'q7',  cat:'🍽️ Niyaz Quality',        text:'How would you rate the quality of the Niyaz (food) today?' },
  { id:'q8',  cat:'🍽️ Mawaid Service',       text:'How was the service provided by the Mawaid Khidmatguzaars today?' },
  { id:'q9',  cat:'🧹 Nazafat',              text:'How clean was the venue including washrooms and common areas today?' },
  { id:'q10', cat:'📢 Communications',       text:'Were the daily communications clear and keeping you well informed?' },
  { id:'q11', cat:'🤲 Rahat & 🏥 Sehat',    text:'If you used Rahat or Sehat services today — how was your experience?' },
];

const RATINGS = [
  { v:'Excellent',         cls:'sel-e', icon:'🟢' },
  { v:'Good',              cls:'sel-g', icon:'🔵' },
  { v:'Needs Improvement', cls:'sel-n', icon:'🟡' },
  { v:'Not Applicable',    cls:'sel-na',icon:'⚫' },
];

let answers = {};
let ratedCount = 0;
let submitting = false;

// ── INIT ────────────────────────────────────────────────────────────────────
window.addEventListener('DOMContentLoaded', () => {
  // Set day from Toronto timezone
  const today = new Date().toLocaleDateString('en-CA', { timeZone:'America/Toronto' });
  const day = DAYS[today];
  const moharramLabel = day ? day.m : 'Ashara 1448H';
  const dateLabel = day ? day.d : today;

  document.getElementById('dayVal').textContent = moharramLabel;
  document.getElementById('dayDate').textContent = dateLabel;
  document.getElementById('dayNoteVal').textContent = moharramLabel;
  document.getElementById('successDay').textContent = moharramLabel;
  answers.day = moharramLabel;
  answers.date = dateLabel;

  // Build questions
  const div = document.getElementById('questionsDiv');
  QUESTIONS.forEach(q => {
    const card = document.createElement('div');
    card.className = 'card';
    card.id = `card_${q.id}`;
    card.innerHTML = `
      <div class="card-label">${q.cat}</div>
      <div class="q-text">${q.text}</div>
      <div class="rating-row" id="row_${q.id}"></div>
    `;
    const row = card.querySelector(`#row_${q.id}`);
    RATINGS.forEach(r => {
      const btn = document.createElement('div');
      btn.className = 'r-btn';
      btn.dataset.q = q.id;
      btn.dataset.v = r.v;
      btn.innerHTML = `<span class="r-icon">${r.icon}</span>${r.v}`;
      btn.onclick = () => pickRating(btn, q.id, r.cls);
      row.appendChild(btn);
    });
    div.appendChild(card);
  });

  updateProgress();
});

// ── GENDER ──────────────────────────────────────────────────────────────────
function pickGender(el, cls) {
  document.querySelectorAll('[data-q="gender"]').forEach(b => b.className = 'gender-btn');
  el.className = `gender-btn ${cls}`;
  answers.gender = el.dataset.v;
  document.getElementById('cardGender').classList.remove('has-error');
  document.getElementById('errGender').classList.remove('show');
  document.getElementById('errBanner').classList.remove('show');
}

// ── RATING ──────────────────────────────────────────────────────────────────
function pickRating(el, qid, cls) {
  const already = !!answers[qid];
  document.querySelectorAll(`[data-q="${qid}"]`).forEach(b => b.className = 'r-btn');
  el.className = `r-btn ${cls}`;
  answers[qid] = el.dataset.v;
  if (!already) ratedCount++;
  updateProgress();
}

// ── PROGRESS ────────────────────────────────────────────────────────────────
function updateProgress() {
  const total = QUESTIONS.length;
  const pct = Math.round((ratedCount / total) * 100);
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressCount').textContent = `${ratedCount} of ${total}`;

  const note = document.getElementById('progressNote');
  if (ratedCount < MIN_ANSWERS) {
    note.textContent = `Please answer at least ${MIN_ANSWERS} questions to submit.`;
    note.style.color = 'var(--muted)';
  } else {
    note.textContent = `✅ You can now submit. Feel free to answer more questions.`;
    note.style.color = 'var(--green)';
  }
}

// ── VALIDATE ────────────────────────────────────────────────────────────────
function validate() {
  let valid = true;
  document.getElementById('errBanner').classList.remove('show');

  // Gender required
  if (!answers.gender) {
    document.getElementById('cardGender').classList.add('has-error');
    document.getElementById('errGender').classList.add('show');
    document.getElementById('cardGender').scrollIntoView({ behavior:'smooth', block:'center' });
    document.getElementById('errBanner').classList.add('show');
    document.getElementById('errText').textContent = 'Please select Gents or Ladies before submitting.';
    valid = false;
  }

  // Min 3 rated questions
  if (ratedCount < MIN_ANSWERS) {
    document.getElementById('errBanner').classList.add('show');
    document.getElementById('errText').textContent = `Please answer at least ${MIN_ANSWERS} questions before submitting. You have answered ${ratedCount} so far.`;
    if (valid) window.scrollTo({ top: 0, behavior: 'smooth' });
    valid = false;
  }

  return valid;
}

// ── SUBMIT WITH RETRY ───────────────────────────────────────────────────────
async function submitWithRetry(payload, maxRetries=3, delayMs=2000) {
  for (let i = 1; i <= maxRetries; i++) {
    try {
      const resp = await fetch(APPSCRIPT_URL, {
        method:'POST',
        headers:{'Content-Type':'text/plain;charset=utf-8'},
        body: JSON.stringify(payload)
      });
      if (resp.ok) return true;
    } catch(e) {
      if (i < maxRetries) await new Promise(r => setTimeout(r, delayMs * i));
    }
  }
  return false;
}

async function submitForm() {
  if (submitting) return;
  if (!validate()) return;

  submitting = true;
  document.getElementById('submitBtn').disabled = true;
  document.getElementById('btnText').textContent = 'Submitting…';
  document.getElementById('spinner').classList.add('show');

  // Capture submission timestamp in Toronto time
  const now = new Date();
  answers.timestamp      = now.toLocaleString('en-CA', { timeZone:'America/Toronto' });
  answers.submissionDate = now.toLocaleDateString('en-CA', { timeZone:'America/Toronto' });
  answers.submissionTime = now.toLocaleTimeString('en-CA', { timeZone:'America/Toronto', hour:'2-digit', minute:'2-digit' });
  answers.comments       = document.getElementById('comments').value.trim();

  await submitWithRetry(answers);

  document.getElementById('formDiv').style.display = 'none';
  document.getElementById('successDiv').style.display = 'block';
  window.scrollTo(0, 0);
}
</script>
</body>
</html>
